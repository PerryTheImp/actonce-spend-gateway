{
  "name": "actonce-spend-gateway",
  "version": "0.1.0",
  "description": "Open-source spending control layer for AI agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo node_modules"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.24.3",
    "better-sqlite3": "^12.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
